# Unpoller : accès LECTURE SEULE au contrôleur UniFi (UDM)
# Crée un utilisateur dédié read-only sur le contrôleur ; ne réutilise pas un compte admin.
# Copie ce fichier en `.env` (gitignoré) et renseigne tes valeurs.

UNPOLLER_URL=https://192.0.2.1     # URL/IP de ton contrôleur UniFi (UDM)
UNPOLLER_USER=unpoller             # utilisateur read-only créé sur l'UDM
UNPOLLER_PASS=change_me            # mot de passe de cet utilisateur
