# Unpoller : accès LECTURE SEULE au contrôleur UniFi (UDM)
# Utiliser un compte dédié read-only créé sur le contrôleur, jamais un compte admin.
# À copier en `.env` (gitignoré) puis compléter avec les valeurs réelles.

UNPOLLER_URL=https://192.0.2.1     # URL/IP du contrôleur UniFi (UDM)
UNPOLLER_USER=unpoller             # utilisateur read-only créé sur l'UDM
UNPOLLER_PASS=change_me            # mot de passe de cet utilisateur
